<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboot.mapper.OrderMapper">
    <resultMap id="OrderInfoResultMap" type="com.example.springboot.entity.OrderInfo">
        <id column="order_id" property="orderId" jdbcType="VARCHAR"/>
        <result column="equip_id" property="equipId" jdbcType="VARCHAR"/>
        <result column="plan_id" property="planId" jdbcType="VARCHAR"/>
        <result column="start_time" property="startTime" jdbcType="TIMESTAMP"/>
        <result column="end_time" property="endTime" jdbcType="TIMESTAMP"/>
        <result column="worker_id" property="workerId" jdbcType="VARCHAR"/>
        <result column="order_desc" property="orderDesc" jdbcType="LONGVARCHAR"/>
        <result column="order_record" property="orderRecord" jdbcType="LONGVARCHAR"/>
        <result column="check_id" property="checkId" jdbcType="VARCHAR"/>
        <result column="order_status" property="orderStatus" jdbcType="VARCHAR"/>
    </resultMap>
    <!-- 分页查询，通过视图简化多表查询 -->
    <select id="getOrdersByPage" parameterType="com.example.springboot.utils.Condition" resultType="com.example.springboot.entity.OrderInfo">
        SELECT * FROM order_summary
        <where>
            <if test="orderId != null and orderId != ''">
                AND order_id LIKE CONCAT('%', #{orderId}, '%')
            </if>
            <if test="startTime != null and endTime != null">
                AND start_time &gt; #{startTime} AND end_time &lt; #{endTime}
            </if>
        </where>
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 条件查询后的总数据条数 -->
    <select id="getOrdersCountByCondition">
        SELECT count(*) FROM order_summary
        <where>
            <if test="orderId != null and orderId != ''">
                AND order_id LIKE CONCAT('%', #{orderId}, '%')
            </if>
            <if test="startTime != null and endTime != null">
                AND start_time &gt; #{startTime} AND end_time &lt; #{endTime}
            </if>
        </where>
    </select>

    <!-- 获取选中工单记录的设备信息，使用视图简化 -->
    <select id="getSelectedEquipInfo" parameterType="com.example.springboot.utils.Condition" resultType="com.example.springboot.entity.SelectedEquipInfo">
        SELECT * FROM selected_equip_summary
        WHERE equip_id = #{equipId} AND plan_id = #{planId}
    </select>

    <!-- 提交工作记录 -->
    <update id="addWorkRecord" parameterType="com.example.springboot.utils.Condition">
        UPDATE order_info
        SET order_record = #{orderRecord}
        WHERE order_id = #{orderId}
    </update>

    <!-- 结单：添加结束时间，更新工单状态 -->
    <update id="submitOrder" parameterType="com.example.springboot.utils.Condition">
        UPDATE order_info
        SET end_time = #{endTime},order_status = "已完成"
        WHERE order_id = #{orderId}
    </update>

    <!-- 结单：自动计算工时 -->
    <update id="autoAddHours" parameterType="com.example.springboot.utils.Condition">
        UPDATE worker_info
        SET pay_hour = ROUND(
                DATEDIFF(#{endTime}, #{startTime}) * 24 +
                    HOUR(TIMEDIFF(#{endTime}, #{startTime})) +
                MINUTE(TIMEDIFF(#{endTime}, #{startTime})) / 60,
        2)
        WHERE worker_id = #{workerId}
    </update>
</mapper>
